{
  // Cloudflare Workers config — static portfolio (public/) + /api/chat chatbot.
  // Secrets/vars for the chatbot (set in Worker settings → Variables and Secrets):
  //   OPENAI_API_KEY (secret, required for primary provider gpt-4o-mini)
  //   OPENAI_MODEL, OLLAMA_BASE_URL, OLLAMA_MODEL (vars, optional)
  //   OLLAMA_API_KEY (secret, optional)
  "name": "new-portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Workers AI — powers the Testing Lab's perception layer (/api/vision).
  // No key or secret: the binding authenticates itself. Usage draws on the
  // account's free daily Neuron allocation, which is why a screen is read
  // once and cached by image hash rather than once per simulated participant.
  "ai": {
    "binding": "AI"
  }
}
